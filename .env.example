# --- Required ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
GROQ_API_KEY=your-groq-api-key
LOG_PUBLIC_URL=https://gist.githubusercontent.com/<username>/<gist-id>/raw/run.jsonl

# --- Optional: model ---
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# --- Optional: logging to a GitHub Gist (token needs only the "gist" scope) ---
GITHUB_TOKEN=your-github-token
GIST_ID=your-gist-id
GIST_FILENAME=run.jsonl
LOCAL_LOG_PATH=run.jsonl

# --- Optional: server ---
PORT=10000

# --- Optional: access control & tuning ---
# ALLOWED_USER_IDS=123456789,987654321
# MAX_AGENT_STEPS=6
# MAX_CONCURRENT=3
# PY_TIMEOUT=25
# PY_MEMORY_MB=1536
# KEEPALIVE=1
# DROP_PENDING_UPDATES=0
